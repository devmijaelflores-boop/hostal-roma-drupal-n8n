COMPOSE_PROJECT_NAME=hostal_roma
DRUPAL_PORT=8080
N8N_PORT=5678
MARIADB_DATABASE=hostal_roma
MARIADB_USER=drupal
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
DRUPAL_HASH_SALT=CHANGE_ME
DRUPAL_ADMIN_USER=admin_demo
DRUPAL_ADMIN_PASSWORD=CHANGE_ME
DRUPAL_ADMIN_EMAIL=admin@example.invalid
N8N_ENCRYPTION_KEY=CHANGE_ME
# Versiones exactas de aplicación; imágenes base reciben parches en su rama.
N8N_VERSION=2.47.3
TZ=America/Lima

# Integración interna: claves distintas del usuario administrador
ROMA_INTEGRATION_TOKEN=CHANGE_ME
ROMA_N8N_WEBHOOK_TOKEN=CHANGE_ME
ROMA_PUBLIC_URL=http://localhost:8080

# AWS/HTTPS: sustituir dominio y URL pública en el servidor, no en Git.
# DOMAIN=reservas.tudominio.pe
# ROMA_TRUSTED_HOSTS=localhost,127.0.0.1,reservas.tudominio.pe
# ROMA_REVERSE_PROXY_ADDRESSES=172.30.99.2
# SUNAT beta: usar solo las credenciales genéricas públicas de la guía Greenter.
# ROMA_SUNAT_BETA_USER=
# ROMA_SUNAT_BETA_PASSWORD=

# Bandeja de correos simulados. SMTP solo interno.
MAILPIT_PORT=8025

# IA opcional: mantener deterministic hasta configurar y probar OpenAI en n8n.
ROMA_CHAT_MODE=deterministic
