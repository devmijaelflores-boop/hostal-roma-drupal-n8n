<?php

/**
 * @file
 * Presentación Drupal alimentada por la base de datos hotelera de demostración.
 */
function roma_elegante_preprocess_page(array &$variables): void {
  $variables['roma_assets'] = base_path() . \Drupal::service('extension.list.theme')->getPath('roma_elegante') . '/assets';
  $variables['roma_rooms'] = [];
  if (\Drupal::hasService('roma_booking.hotel')) {
    $hotel = \Drupal::service('roma_booking.hotel');
    $rooms = $hotel->rooms();
    foreach ($hotel->types() as $type) {
      $matching = array_values(array_filter($rooms, static fn(array $r): bool => (int) $r['type_id'] === (int) $type['id']));
      $type['bed'] = 'Distribución de la habitación';
      $type['price_display'] = \Drupal\roma_booking\Service\HotelService::money((int) $type['amount']);
      $type['request_url'] = \Drupal\Core\Url::fromRoute('roma_booking.request', [], ['query' => $matching ? ['room' => $matching[0]['id']] : []])->toString();
      $variables['roma_rooms'][] = $type;
    }
    $variables['roma_services'] = $hotel->services();
  }
  $variables['roma_content'] = \Drupal::config('roma_booking.content')->getRawData();
  $variables['roma_content'] += ['hotel_name'=>'ROMA','brand_subtitle'=>'GOLDEN · JULIACA','city'=>'Juliaca','region'=>'Puno','country'=>'Perú'];
  $variables['roma_maps_url'] = 'https://www.google.com/maps/dir/?api=1&destination=' . rawurlencode($variables['roma_content']['address'] ?? 'Nueva Zelandia 196, Juliaca, Perú');
  \Drupal::service('renderer')->addCacheableDependency($variables, \Drupal::config('roma_booking.content'));
  $number = ltrim((string) ($variables['roma_content']['whatsapp'] ?? ''), '+');
  $variables['roma_whatsapp_url'] = preg_match('/^[1-9][0-9]{7,14}$/D', $number) ? 'https://wa.me/' . $number . '?text=' . rawurlencode('Hola, quisiera consultar habitaciones y disponibilidad.') : '';
  $photos=\Drupal::config('roma_booking.photos');
  $gallery=static function(string $key,array $fallback) use($photos): array {
    $urls=[];
    foreach(\Drupal\file\Entity\File::loadMultiple($photos->get('galleries.'.$key.'.files')??[]) as $file) {
      if(str_starts_with($file->getFileUri(),'public://hotel-photos/'))$urls[]=\Drupal::service('file_url_generator')->generateString($file->getFileUri());
    }
    return ['images'=>$urls?:$fallback,'alt'=>$photos->get('galleries.'.$key.'.alt')?:'Interior ilustrativo','custom'=>(bool)$urls];
  };
  $variables['roma_hero']=$gallery('hero',[$variables['roma_assets'].'/images/individual.jpg',$variables['roma_assets'].'/images/matrimonial.jpg',$variables['roma_assets'].'/images/doble.jpg']);
  foreach($variables['roma_rooms'] as &$room){$room['gallery']=$gallery('room_'.$room['id'],[$variables['roma_assets'].'/images/'.$room['image']]);}unset($room);
  \Drupal::service('renderer')->addCacheableDependency($variables,$photos);
  $prices=array_column($variables['roma_rooms'],'amount');
  $variables['roma_min_price']=$prices ? \Drupal\roma_booking\Service\HotelService::money((int)min($prices)) : NULL;
  $variables['roma_notice'] = 'Encuentra tu habitación y planifica tu estadía';
}
