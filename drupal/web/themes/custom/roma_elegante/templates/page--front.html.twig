{% import '@roma_elegante/icons.html.twig' as ui %}
{% include '@roma_elegante/header.html.twig' %}
<main id="main-content" tabindex="-1">
  {{ page.highlighted }}
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <img class="hero-image" src="{{ roma_assets }}/images/hero.jpg" alt="Interior cálido de una habitación de referencia; no corresponde al Hostal ROMA" width="1800" height="1200" fetchpriority="high">
    <div class="hero-shade"></div>
    <div class="hero-credit">Fotografía referencial · Unsplash</div>
    <div class="wrap hero-content">
      <p class="eyebrow light">{{ ui.icon('pin') }} {{ roma_content.city }} · {{ roma_content.region }} · {{ roma_content.country }}</p>
      <h1 id="hero-title">Tu pausa en el<br>corazón del <em>altiplano.</em></h1>
      <p class="hero-description">Hay viajes que merecen un buen descanso.<br>Imagina el tuyo con nosotros.</p>
      <a class="button button-cream" href="#habitaciones">Descubre las habitaciones {{ ui.icon('arrow') }}</a>
      <div class="hero-footnote"><span></span> UNA PROPUESTA DE HOSPITALIDAD, HECHA CON CALMA</div>
    </div>
    <div class="hero-seal" aria-hidden="true"><span>DESCANSA</span>✧<span>SIGUE EL VIAJE</span></div>
  </section>

  <section class="planner-section wrap" id="planifica" aria-label="Consulta disponibilidad">
    <form class="stay-planner" id="stay-planner" action="{{ path('roma_booking.availability') }}" method="get">
      <div class="planner-field"><label for="arrival">{{ ui.icon('calendar') }} Llegada</label><input type="date" id="arrival" name="arrival" required></div>
      <div class="planner-field"><label for="departure">{{ ui.icon('calendar') }} Salida</label><input type="date" id="departure" name="departure" required></div>
      <div class="planner-field"><label for="guests">{{ ui.icon('user') }} Huéspedes</label><select id="guests" name="guests"><option value="1">1 huésped</option><option value="2" selected>2 huéspedes</option><option value="3">3 huéspedes</option><option value="4">4 huéspedes</option></select></div>
      <button class="button button-dark planner-submit" type="submit">Consultar {{ ui.icon('arrow') }}</button>
    </form>
    <div class="planner-caption"><span class="small-label">DEMO FUNCIONAL</span><span>Disponibilidad calculada con datos de la demo. Solo las reservas confirmadas bloquean habitaciones.</span></div>
    <p id="planner-result" class="planner-result" role="status" hidden></p>
    <noscript><p>Puedes consultar la disponibilidad sin JavaScript usando este formulario.</p></noscript>
  </section>

  <section class="welcome wrap section-space" aria-labelledby="welcome-title">
    <div class="welcome-heading"><p class="eyebrow">BIENVENIDO A {{ roma_content.hotel_name }}</p><h2 id="welcome-title">Un lugar para bajar<br>el ritmo. <em>Y sentirte bien.</em></h2></div>
    <div class="welcome-copy"><p>{{ roma_content.presentation|default('Entre nuevos caminos y días por descubrir, siempre hay espacio para una pausa. Esta propuesta reúne ambientes acogedores, detalles sencillos y la inspiración del altiplano.') }}</p><p class="muted">Explora nuestro catálogo ficticio y descubre cómo será la experiencia de este proyecto académico.</p><a class="text-link" href="#servicios">Los detalles que importan {{ ui.icon('arrow') }}</a></div>
  </section>

  <section class="rooms-section section-space" id="habitaciones" aria-labelledby="rooms-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">ESPACIOS PARA DESCONECTAR</p><h2 id="rooms-title">Encuentra tu <em>descanso.</em></h2></div><p>Tres formas de imaginar tu estadía.<br><span class="muted">Catálogo y tarifas de demostración.</span></p></div>
      <div class="room-filters" role="group" aria-label="Filtrar habitaciones de muestra"><button type="button" data-room-filter="all" aria-pressed="true">Todas las habitaciones</button><button type="button" data-room-filter="1" aria-pressed="false">Para una persona</button><button type="button" data-room-filter="2" aria-pressed="false">Para dos personas</button></div>
      <div class="room-grid">
        {% for room in roma_rooms %}
          <article class="room-card" data-capacity="{{ room.capacity }}">
            <div class="room-image-wrap"><img src="{{ roma_assets }}/images/{{ room.image }}" alt="Fotografía ilustrativa para la categoría {{ room.name }}; no es una habitación del hostal" width="900" height="600" loading="lazy"><span class="image-label">Habitación</span><span class="room-number">0{{ loop.index }}</span></div>
            <div class="room-card-body"><p class="room-category">{{ room.category }}</p><h3>{{ room.name }}</h3><div class="room-meta"><span>{{ ui.icon('user') }} {{ room.capacity }} {{ room.capacity == 1 ? 'huésped' : 'huéspedes' }}</span><span>{{ ui.icon('bed') }} {{ room.bed }}</span></div><p class="room-description">{{ room.description }}</p><div class="room-card-bottom"><div><span class="price-caption">Desde</span><strong>{{ room.price_display }}<span> / noche</span></strong></div><button class="room-details" type="button" data-room="{{ room.id }}" aria-label="Ver detalles de la habitación {{ room.name }}">{{ ui.icon('diagonal') }}</button></div></div>
          </article>
        {% endfor %}
      </div>
      <p class="room-filter-status visually-hidden" role="status"></p>
      <p class="catalog-note">{{ ui.icon('check') }} Precios ficticios en soles peruanos (PEN). Las imágenes no corresponden al establecimiento real.</p>
    </div>
  </section>

  <section class="services-section section-space" id="servicios" aria-labelledby="services-title">
    <div class="wrap"><div class="section-heading"><div><p class="eyebrow light">LO SENCILLO, BIEN PENSADO</p><h2 id="services-title">Pequeños detalles.<br><em>Una mejor pausa.</em></h2></div><p>Comodidades que forman parte de nuestra<br>propuesta de demostración.</p></div>
      <div class="services-grid">{% for service in roma_services %}<article>{{ ui.icon(loop.index == 1 ? 'wifi' : (loop.index == 2 ? 'car' : (loop.index == 3 ? 'shower' : 'sun'))) }}<h3>{{ service.name }}</h3><p>{{ service.description }}</p></article>{% endfor %}</div>
      <p class="services-disclaimer">Servicios de demostración; no constituyen una oferta del negocio real.</p>
    </div>
  </section>

  <section class="location-section wrap section-space" id="ubicacion" aria-labelledby="location-title">
    <div class="location-art" role="img" aria-label="Ilustración conceptual del altiplano; no es un mapa ni una ubicación exacta"><div class="art-sun"></div><div class="art-mountain mountain-back"></div><div class="art-mountain mountain-front"></div><div class="art-lake"></div><span class="art-coordinate">{{ roma_content.region }} · {{ roma_content.country }}</span><div class="art-place">{{ roma_content.city }}<span>EL ALTIPLANO TE INSPIRA</span></div><span class="art-caption">Ilustración conceptual del entorno andino</span></div>
    <div class="location-copy"><p class="eyebrow">UN DESTINO, MUCHAS HISTORIAS</p><h2 id="location-title">El viaje empieza<br>en <em>{{ roma_content.city }}.</em></h2><p>{{ roma_content.location_text|default('El altiplano es el escenario de esta propuesta. Juliaca, en Puno, Perú, es la ciudad de referencia de nuestro proyecto académico.') }}</p><div class="location-address">{{ ui.icon('pin') }}<div><strong>{{ roma_content.address|default('Nueva Zelandia 196, Juliaca 21101, Puno, Perú') }}</strong><span>Dirección</span></div></div><p class="muted small"> Sistema independiente sin afiliación al establecimiento.</p><a class="text-link" href="{{ roma_maps_url }}" target="_blank" rel="noopener noreferrer">Cómo llegar · Google Maps {{ ui.icon('diagonal') }}</a></div>
  </section>

  <section class="closing-section"><div class="wrap closing-inner"><div><p class="eyebrow">TU PRÓXIMA PAUSA</p><h2>Todo buen viaje merece<br>un <em>buen descanso.</em></h2></div><div><a class="button button-dark" href="#planifica">Planifica tu estadía {{ ui.icon('diagonal') }}</a><p>Una experiencia de demostración, por ahora.</p></div></div></section>
</main>
{% include '@roma_elegante/footer.html.twig' %}

{% for room in roma_rooms %}
<dialog class="room-dialog" id="room-{{ room.id }}" aria-labelledby="dialog-title-{{ room.id }}">
  <button class="dialog-close" type="button" aria-label="Cerrar detalles">{{ ui.icon('close') }}</button>
  <img src="{{ roma_assets }}/images/{{ room.image }}" alt="Habitación de la categoría {{ room.name }}" width="900" height="600" loading="lazy">
  <div class="dialog-content"><p class="eyebrow">HABITACIÓN DE DEMOSTRACIÓN</p><h2 id="dialog-title-{{ room.id }}">{{ room.name }}</h2><p>{{ room.description }}</p><p>{{ room.bed }} · Capacidad ilustrativa: {{ room.capacity }} {{ room.capacity == 1 ? 'persona' : 'personas' }}.</p><p class="dialog-price">{{ room.price_display }} <span>por noche · tarifa ficticia</span></p><p class="demo-explanation">Catálogo ficticio con inventario y solicitudes de prueba en la base de datos. La disponibilidad se comprueba al solicitar y confirmar. </p><a class="button button-dark dialog-plan" href="{{ room.request_url }}">Solicitar reserva {{ ui.icon('arrow') }}</a></div>
</dialog>
{% endfor %}
