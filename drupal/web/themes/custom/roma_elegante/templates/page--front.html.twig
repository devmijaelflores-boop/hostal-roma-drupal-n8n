{% import '@roma_elegante/icons.html.twig' as ui %}
{% include '@roma_elegante/header.html.twig' %}
<main id="main-content" tabindex="-1">
  {{ page.highlighted }}
  <section class="hero" id="inicio" aria-labelledby="hero-title" data-gallery data-images="{{ roma_hero.images|json_encode|e('html_attr') }}">
    <img class="hero-image" data-gallery-image src="{{ roma_hero.images[0] }}" alt="{{ roma_hero.alt }}" width="1800" height="1200" fetchpriority="high">
    <div class="gallery-controls hero-gallery-controls"><button type="button" data-gallery-play aria-label="Pausar carrusel" aria-pressed="false">Ⅱ</button><button type="button" data-gallery-prev aria-label="Foto anterior">←</button><span data-gallery-count aria-live="polite">1 / 3</span><button type="button" data-gallery-next aria-label="Foto siguiente">→</button><button type="button" data-gallery-expand aria-label="Ampliar fotografía">⤢</button></div>
    {% if not roma_hero.custom %}<video class="hero-video" id="hero-video" data-src="{{ roma_assets }}/video/hotel-interior.mp4" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video><button class="hero-video-control" id="hero-video-control" type="button" aria-label="Reproducir video" aria-pressed="false" hidden>Ver video</button>{% endif %}
    <div class="hero-shade"></div>
    {% if not roma_hero.custom %}<div class="hero-credit" data-video-credit>Imagen y video · Mixkit</div>{% endif %}
    <div class="wrap hero-content"><div class="hero-intro">
      <p class="eyebrow light">TU PRÓXIMA PAUSA</p>
      <h1 id="hero-title">{{ roma_content.hotel_name }}</h1>
      <p class="hero-description">Encuentra el espacio para tu próximo descanso.</p>
      {% if roma_min_price %}<p class="hero-rate">Habitaciones desde <strong>{{ roma_min_price }}</strong><span>por noche · según habitación</span></p>{% endif %}
      </div>
    </div>
    <div class="hero-seal" aria-hidden="true"><span>DESCANSA</span>✧<span>SIGUE EL VIAJE</span></div>
  </section>

  <section class="planner-section wrap" id="planifica" aria-label="Consulta disponibilidad">
    <form class="stay-planner" id="stay-planner" action="{{ path('roma_booking.availability') }}" method="get">
      <div class="planner-field"><label for="arrival">{{ ui.icon('calendar') }} Llegada</label><input type="date" id="arrival" name="arrival" required></div>
      <div class="planner-field"><label for="departure">{{ ui.icon('calendar') }} Salida</label><input type="date" id="departure" name="departure" required></div>
      <div class="planner-field"><label for="guests">{{ ui.icon('user') }} Huéspedes</label><select id="guests" name="guests"><option value="1">1 huésped</option><option value="2" selected>2 huéspedes</option><option value="3">3 huéspedes</option><option value="4">4 huéspedes</option></select></div>
      <button class="button button-dark planner-submit" type="submit">Ver habitaciones {{ ui.icon('arrow') }}</button>
    </form>
    <div class="planner-caption"><span>Elige fechas y huéspedes para consultar habitaciones y el total de tu estadía.</span></div>
    <p id="planner-result" class="planner-result" role="status" hidden></p>
    <noscript><p>Puedes consultar la disponibilidad sin JavaScript usando este formulario.</p></noscript>
  </section>

  <section class="welcome wrap section-space" aria-labelledby="welcome-title">
    <figure class="welcome-visual"><img src="{{ roma_rooms[0].gallery.images[0]|default(roma_hero.images[0]) }}" alt="{{ roma_rooms[0].gallery.alt|default(roma_hero.alt) }}" width="900" height="600" loading="lazy" decoding="async"><figcaption><span>01</span> Un espacio para descansar.</figcaption></figure>
    <div class="welcome-copy"><p class="eyebrow">BIENVENIDO A {{ roma_content.hotel_name }}</p><h2 id="welcome-title">Tu viaje.<br><em>Tu forma de descansar.</em></h2><p>{{ roma_content.presentation|default('Compara habitaciones, descubre sus detalles y elige el espacio que se ajuste a tu viaje.') }}</p><a class="text-link" href="#habitaciones">Explora las habitaciones {{ ui.icon('arrow') }}</a></div>
  </section>

  <section class="rooms-section section-space" id="habitaciones" aria-labelledby="rooms-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">ESPACIOS PARA DESCONECTAR</p><h2 id="rooms-title">Encuentra tu <em>descanso.</em></h2></div><p>Opciones para tu estadía.<br><span class="muted">Catálogo de habitaciones y tarifas.</span></p></div>
      <div class="room-filters" role="group" aria-label="Filtrar habitaciones de muestra"><button type="button" data-room-filter="all" aria-pressed="true">Todas las habitaciones</button><button type="button" data-room-filter="1" aria-pressed="false">Para una persona</button><button type="button" data-room-filter="2" aria-pressed="false">Para dos personas</button></div>
      <div class="room-grid">
        {% for room in roma_rooms %}
          <article class="room-card" data-capacity="{{ room.capacity }}">
            <div class="room-image-wrap"><img src="{{ room.gallery.images[0] }}" alt="{{ room.gallery.alt }}" width="900" height="600" loading="lazy"><span class="image-label">Habitación</span><span class="room-number">0{{ loop.index }}</span></div>
            <div class="room-card-body"><p class="room-category">{{ room.category }}</p><h3>{{ room.name }}</h3><div class="room-meta"><span>{{ ui.icon('user') }} {{ room.capacity }} {{ room.capacity == 1 ? 'huésped' : 'huéspedes' }}</span><span>{{ ui.icon('bed') }} {{ room.bed }}</span></div><p class="room-description">{{ room.description }}</p><div class="room-card-bottom"><div><span class="price-caption">Desde</span><strong>{{ room.price_display }}<span> / noche</span></strong></div><button class="room-details" type="button" data-room="{{ room.id }}" aria-label="Ver detalles de la habitación {{ room.name }}"><span>Ver habitación</span>{{ ui.icon('diagonal') }}</button></div></div>
          </article>
        {% endfor %}
      </div>
      <p class="room-filter-status visually-hidden" role="status"></p>
      <p class="catalog-note">{{ ui.icon('check') }} Tarifas en soles peruanos (PEN), por habitación y noche.</p>
    </div>
  </section>

  <section class="wrap hotel-story" id="historia">{% if roma_content.story_text %}<p class="eyebrow">CONÓCENOS</p><h2>{{ roma_content.story_title|default('Nuestra historia') }}</h2><p>{{ roma_content.story_text }}</p>{% else %}<p class="eyebrow">TU ESTADÍA, PASO A PASO</p><h2>Reserva sin complicaciones.</h2><ol class="booking-story-steps"><li><span>01</span><h3>Elige tus fechas.</h3><p>Indica llegada, salida y huéspedes.</p></li><li><span>02</span><h3>Encuentra tu espacio.</h3><p>Compara capacidad y total de la estadía.</p></li><li><span>03</span><h3>Envía tu solicitud.</h3><p>Guarda tu código para consultar la confirmación.</p></li></ol>{% endif %}</section>
  <section class="services-section section-space" id="servicios" aria-labelledby="services-title">
    <div class="wrap"><div class="section-heading"><div><p class="eyebrow light">LO SENCILLO, BIEN PENSADO</p><h2 id="services-title">Pequeños detalles.<br><em>Una mejor pausa.</em></h2></div><p>Comodidades que forman parte de nuestra<br>propuesta de alojamiento.</p></div>
      <div class="services-grid">{% for service in roma_services %}<article>{{ ui.icon(loop.index == 1 ? 'wifi' : (loop.index == 2 ? 'car' : (loop.index == 3 ? 'shower' : 'sun'))) }}<h3>{{ service.name }}</h3><p>{{ service.description }}</p></article>{% endfor %}</div>
      <p class="services-disclaimer">Servicios del catálogo; consulta sus condiciones con recepción.</p>
    </div>
  </section>

  <section class="location-section wrap section-space" id="ubicacion" aria-labelledby="location-title">
    <div class="hotel-map"><h3>Encuéntranos</h3><p>{{ roma_content.address }}</p><button class="button button-dark" type="button" id="hotel-map-open" data-address="{{ roma_content.address|default('Nueva Zelandia 196, Juliaca, Perú') }}">Ver mapa</button><div id="hotel-map-frame"></div><noscript><a href="{{ roma_maps_url }}">Abrir mapa</a></noscript></div>
    <div class="location-copy"><p class="eyebrow">UN DESTINO, MUCHAS HISTORIAS</p><h2 id="location-title">El viaje empieza<br>en <em>{{ roma_content.city }}.</em></h2><p>{{ roma_content.location_text|default('El altiplano es el escenario de esta propuesta. Juliaca, en Puno, Perú, es la ciudad de referencia de nuestro proyecto académico.') }}</p><div class="location-address">{{ ui.icon('pin') }}<div><strong>{{ roma_content.address|default('Nueva Zelandia 196, Juliaca 21101, Puno, Perú') }}</strong><span>Dirección</span></div></div><p class="muted small"> Sistema independiente sin afiliación al establecimiento.</p><a class="text-link" href="{{ roma_maps_url }}" target="_blank" rel="noopener noreferrer">Cómo llegar · Google Maps {{ ui.icon('diagonal') }}</a></div>
  </section>

  <section class="closing-section"><div class="wrap closing-inner"><div><p class="eyebrow">TU PRÓXIMA PAUSA</p><h2>Todo buen viaje merece<br>un <em>buen descanso.</em></h2></div><div><a class="button button-dark" href="#planifica">Planifica tu estadía {{ ui.icon('diagonal') }}</a><p>Encuentra una opción para tu próximo viaje.</p></div></div></section>
</main>
{% include '@roma_elegante/footer.html.twig' %}

{% for room in roma_rooms %}
<dialog class="room-dialog" id="room-{{ room.id }}" aria-labelledby="dialog-title-{{ room.id }}">
  <button class="dialog-close" type="button" aria-label="Cerrar detalles">{{ ui.icon('close') }}</button>
  <div class="room-gallery" data-gallery data-images="{{ room.gallery.images|json_encode|e('html_attr') }}"><button type="button" class="gallery-image-button" data-gallery-expand aria-label="Ampliar fotografía"><img data-gallery-image src="{{ room.gallery.images[0] }}" alt="{{ room.gallery.alt }}" width="900" height="600" loading="lazy"></button><div class="gallery-controls"><button type="button" data-gallery-prev aria-label="Foto anterior">←</button><span data-gallery-count aria-live="polite">1 / {{ room.gallery.images|length }}</span><button type="button" data-gallery-next aria-label="Foto siguiente">→</button></div>{% if not room.gallery.custom %}<p class="gallery-caption">Galería de interiores</p>{% endif %}</div>
  <div class="dialog-content"><p class="eyebrow">HABITACIÓN</p><h2 id="dialog-title-{{ room.id }}">{{ room.name }}</h2><p>{{ room.description }}</p><p>{{ room.bed }} · Capacidad: {{ room.capacity }} {{ room.capacity == 1 ? 'persona' : 'personas' }}.</p><p class="dialog-price">{{ room.price_display }} <span>por noche</span></p><p class="demo-explanation">La disponibilidad se comprueba al enviar la solicitud y antes de confirmarla.</p><a class="button button-dark dialog-plan" href="{{ room.request_url }}">Solicitar reserva {{ ui.icon('arrow') }}</a></div>
</dialog>
{% endfor %}

<dialog id="photo-viewer" class="photo-viewer" aria-label="Fotografía ampliada"><button type="button" class="photo-viewer-close" aria-label="Cerrar fotografía">×</button><img alt=""><p>Galería de interiores</p></dialog>
