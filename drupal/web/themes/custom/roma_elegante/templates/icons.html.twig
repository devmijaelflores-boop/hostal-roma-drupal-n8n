{% macro icon(name, class = '') %}
<svg class="icon {{ class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if name == 'arrow' %}<path d="M5 12h14M13 6l6 6-6 6"/>
{% elseif name == 'diagonal' %}<path d="M6 18 18 6M6 6h12v12"/>
{% elseif name == 'pin' %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
{% elseif name == 'calendar' %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18M8 15h2m4 0h2"/>
{% elseif name == 'user' %}<circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
{% elseif name == 'bed' %}<path d="M3 18v3m18-3v3M3 11V5h18v6M2 18v-6a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v6Zm4-7V8h5v3m2 0V8h5v3"/>
{% elseif name == 'wifi' %}<path d="M2 8a16 16 0 0 1 20 0M5 12a11 11 0 0 1 14 0M8 16a6 6 0 0 1 8 0"/><circle cx="12" cy="20" r=".6"/>
{% elseif name == 'car' %}<path d="m4 11 2-6h12l2 6M3 18v2m18-2v2M2 11h20v7H2Z"/><path d="M6 14h2m8 0h2"/>
{% elseif name == 'shower' %}<path d="M5 21V6a4 4 0 0 1 8 0v1m-3 4a4 4 0 0 1 8 0Zm1 3v1m3-1v1m3-1v1m-6 3v1m3-1v1m3-1v1"/>
{% elseif name == 'sun' %}<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/>
{% elseif name == 'chat' %}<path d="M21 11a9 9 0 0 1-9 9 10 10 0 0 1-4-.8L3 21l1.8-5A10 10 0 0 1 3 11a9 9 0 1 1 18 0Z"/><path d="M8 11h.01M12 11h.01M16 11h.01"/>
{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
{% elseif name == 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
{% elseif name == 'menu' %}<path d="M3 6h18M3 12h18M3 18h18"/>
{% endif %}
</svg>
{% endmacro %}
