<?php
/** Implements hook_schema(). */
function roma_api_schema(): array {
  return ['roma_notification' => [
    'fields'=>[
      'id'=>['type'=>'serial','unsigned'=>TRUE,'not null'=>TRUE],
      'event_key'=>['type'=>'varchar','length'=>100,'not null'=>TRUE],
      'reservation_id'=>['type'=>'int','unsigned'=>TRUE,'not null'=>TRUE,'default'=>0],
      'kind'=>['type'=>'varchar','length'=>30,'not null'=>TRUE],
      'state'=>['type'=>'varchar','length'=>16,'not null'=>TRUE,'default'=>'queued'],
      'attempts'=>['type'=>'int','unsigned'=>TRUE,'not null'=>TRUE,'default'=>0],
      'created'=>['type'=>'int','unsigned'=>TRUE,'not null'=>TRUE],
      'delivered'=>['type'=>'int','unsigned'=>TRUE,'not null'=>TRUE,'default'=>0],
    ],'primary key'=>['id'],'unique keys'=>['event_key'=>['event_key']],'indexes'=>['state'=>['state']],
  ]];
}
